{
  "manifest_version": 3,
  "name": "段译 · AI 网页双语翻译",
  "description": "用自己的 API Key 翻译网页正文、选区和悬停段落，并为指定网站启用自动双语阅读。",
  "version": "1.1.1",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "commands": {
    "translate-full-page": {
      "suggested_key": { "default": "Alt+A" },
      "description": "翻译当前整页"
    }
  },
  "action": {
    "default_title": "段译 · 翻译当前网页",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": {
    "16": "icons/icon16.png", "32": "icons/icon32.png",
    "48": "icons/icon48.png", "128": "icons/icon128.png"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src https:"
  }
}
